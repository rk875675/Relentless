      "timed_text": [
        {
          "start_s": 0.0,
          "text": "Day 25."
        },
        {
          "start_s": 2.1,
          "text": "The five seconds after a mistake matter more than the mistake itself."
        },
        {
          "start_s": 9.22,
          "text": "Here's the pattern."
        },
        {
          "start_s": 11.28,
          "text": "Athlete makes error."
        },
        {
          "start_s": 13.34,
          "text": "Brain fires immediately."
        },
        {
          "start_s": 15.44,
          "text": "Replays the mistake."
        },
        {
          "start_s": 17.76,
          "text": "Catastrophizes the consequences."
        },
        {
          "start_s": 22.0,
          "text": "Athlete carries that weight into the next play."
        },
        {
          "start_s": 26.06,
          "text": "Next play breaks down."
        },
        {
          "start_s": 27.68,
          "text": "Spiral."
        },
        {
          "start_s": 28.88,
          "text": "The mistake didn't cost them."
        },
        {
          "start_s": 31.66,
          "text": "The five seconds after did."
        },
        {
          "start_s": 33.84,
          "text": "Your job in those five seconds is one thing."
        },
        {
          "start_s": 37.18,
          "text": "Interruption."
        },
        {
          "start_s": 38.42,
          "text": "You are not processing the mistake."
        },
        {
          "start_s": 40.56,
          "text": "You are not evaluating what went wrong."
        },
        {
          "start_s": 42.82,
          "text": "You have one job."
        },
        {
          "start_s": 44.12,
          "text": "Get back to the next play."
        },
        {
          "start_s": 46.24,
          "text": "Three steps."
        },
        {
          "start_s": 47.54,
          "text": "Reset word."
        },
        {
          "start_s": 48.84,
          "text": "Say it."
        },
        {
          "start_s": 49.42,
          "text": "Physical cue."
        },
        {
          "start_s": 51.0,
          "text": "Run it."
        },
        {
          "start_s": 51.8,
          "text": "Focus anchor."
        },
        {
          "start_s": 53.0,
          "text": "Return to it."
        },
        {
          "start_s": 54.36,
          "text": "Five seconds."
        },
        {
          "start_s": 55.52,
          "text": "Back in the game."
        },
        {
          "start_s": 57.04,
          "text": "Drill that sequence three times back to back until it's locked."
        },
        {
          "start_s": 62.46,
          "text": "On your screen you are going to walk through it right now."
        }
      ]
    },
    {
