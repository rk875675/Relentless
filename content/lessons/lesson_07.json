        {
          "start_s": 9.78,
          "text": "Today we build the tool that ties all of it together."
        },
        {
          "start_s": 13.0,
          "text": "It's called a focus anchor."
        },
        {
          "start_s": 18.88,
          "text": "A word, a short phrase, or a physical sensation that your mind comes back to when it starts to drift."
        },
        {
          "start_s": 31.76,
          "text": "Today you choose yours on purpose."
        },
        {
          "start_s": 37.74,
          "text": "It should be short — one or two words max."
        },
        {
          "start_s": 41.94,
          "text": "Process-focused, not outcome-focused."
        },
        {
          "start_s": 50.76,
          "text": "Examples: next play, breathe, process, here, trust."
        },
        {
          "start_s": 59.0,
          "text": "Before we start — take one box breath to settle in."
        }
      ]
