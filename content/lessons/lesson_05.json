        {
          "start_s": 1.1,
          "text": "Day 5."
        },
        {
          "start_s": 2.68,
          "text": "First physical tool."
        },
        {
          "start_s": 5.22,
          "text": "It's called box breathing."
        },
        {
          "start_s": 7.74,
          "text": "Four sides."
        },
        {
          "start_s": 8.8,
          "text": "Four seconds each."
        },
        {
          "start_s": 19.12,
          "text": "When you're in a high-pressure moment, your body runs hot."
        },
        {
          "start_s": 25.72,
          "text": "Your brain shifts into threat mode."
        },
        {
          "start_s": 30.3,
          "text": "None of that is useful for execution."
        },
        {
          "start_s": 33.32,
          "text": "Box breathing is a reset switch."
        },
        {
          "start_s": 36.34,
          "text": "When you control the breath, you directly activate the part of your nervous system that says calm down."
        },
        {
          "start_s": 54.8,
          "text": "On your screen you're going to see a circle."
        },
        {
          "start_s": 68.54,
          "text": "Follow it."
        },
        {
          "start_s": 71.46,
          "text": "If your mind drifts — bring it back."
        },
        {
          "start_s": 74.48,
          "text": "That is not failure."
        },
        {
          "start_s": 76.0,
          "text": "That is the drill."
        }
      ]
    },
