EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: override OAuth / password-recovery deep-link base (must match Supabase Auth redirect allow list)
# If unset, URLs are built from the app URL scheme in app.json (e.g. relentless://auth-callback).
# Expo Go does NOT use that scheme — it uses exp://…/--/auth-callback. Either add that exact
# URL to Supabase Redirect URLs (Metro prints it), or set a stable HTTPS base here and allow
# https://your-host/auth-callback in Supabase (e.g. tunnel for dev).
# EXPO_PUBLIC_AUTH_REDIRECT_BASE=https://your.app
# EXPO_PUBLIC_APP_URL_SCHEME=relentless
#
# OAuth in-app browser often shows "Sign in to <project>.supabase.co" — that host is Supabase’s.
# To show a branded domain in the sheet, use a Supabase custom domain (project settings) and update
# EXPO_PUBLIC_SUPABASE_URL to match. Google’s OAuth consent screen "App name" should also say "Relentless".

# Superwall (public iOS key from the Superwall dashboard)
EXPO_PUBLIC_SUPERWALL_IOS_API_KEY=
# Set to true to disable Superwall JS/native entirely (debug crashes)
# EXPO_PUBLIC_SUPERWALL_DISABLE=true
# Placement name that presents your remote onboarding paywall (dashboard must match)
EXPO_PUBLIC_SUPERWALL_ONBOARDING_PLACEMENT=onboarding_paywall

# Legal URLs for subscription disclosure (https only; must match App Store Connect / your hosted docs)
# Privacy Policy link in the app is fixed to https://relentlessmentaltoughness.com/privacy-policy/ (see lib/legal-urls.ts).
# For Apple’s standard Licensed Application EULA, use:
# EXPO_PUBLIC_TERMS_OF_USE_URL=https://www.apple.com/legal/internet-services/itunes/dev/stdeula/
# Or set to your custom Terms of Use URL.
# EXPO_PUBLIC_TERMS_OF_USE_URL=
