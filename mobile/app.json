{
  "expo": {
    "name": "Relentless",
    "slug": "relentless",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "relentless",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "buildNumber": "5",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.relentlessmentaltoughness.relentless",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-asset",
      "expo-iap",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3cac0b27-c2b7-4368-a154-b4292e7d7030"
      }
    },
    "android": {
      "versionCode": 5,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.relentlessmentaltoughness.relentless"
    },
    "owner": "r2.rahul"
  }
}
