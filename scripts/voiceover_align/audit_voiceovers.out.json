                "cue_idx": 1,
                "start_s": 2.44,
                "n_sentences": 2,
                "text": "You've got your baseline. You know where you're starting."
              },
              {
                "kind": "MULTI",
                "cue_idx": 3,
                "start_s": 13.28,
                "n_sentences": 2,
