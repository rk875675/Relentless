          "whisper_segments": [
            {
              "start_s": 0.46,
              "end_s": 6.02,
              "text": "Okay, so now that you're in a good relaxed position, let's close your eyes."
            },
            {
              "start_s": 6.02,
              "end_s": 10.38,
              "text": "So we're moving from the top of your head down to your feet."
            },
            {
              "start_s": 10.38,
              "end_s": 17.62,
              "text": "At each zone, we're going to breathe in and release whatever you find on the exhale."
            },
            {
              "start_s": 17.62,
              "end_s": 22.74,
              "text": "Don't force anything, just notice and let go."
            },
            {
              "start_s": 22.74,
              "end_s": 28.31,
              "text": "So right now, focus on the top of your head."
            },
            {
              "start_s": 28.31,
              "end_s": 33.91,
              "text": "Keep that deep breathing going as you think about the sensations on your head."
