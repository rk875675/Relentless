              },
              {
                "kind": "MULTI",
                "cue_idx": 6,
                "start_s": 51.32,
                "n_sentences": 4,
                "text": "Today you're going to write your identity. Present tense. Specific. Behavioral."
              },
              {
                "kind": "GAP",
                "cue_idx": 6,
                "start_s": 51.32,
                "next_start_s": 70.18,
