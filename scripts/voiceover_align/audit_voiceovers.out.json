          "current_total_audio_seconds": 76.74,
          "current_cue_count": 8,
          "audit": {
            "issue_count": 6,
            "issues": [
              {
                "kind": "MULTI",
                "cue_idx": 0,
                "start_s": 1.1,
                "n_sentences": 2,
                "text": "Day 5. First physical tool."
              },
              {
                "kind": "MULTI",
                "cue_idx": 1,
                "start_s": 5.22,
                "n_sentences": 3,
                "text": "It's called box breathing. Four sides. Four seconds each."
              },
              {
                "kind": "MULTI",
                "cue_idx": 3,
                "start_s": 25.72,
                "n_sentences": 2,
                "text": "Your brain shifts into threat mode. None of that is useful for execution."
              },
              {
                "kind": "GAP",
                "cue_idx": 5,
                "start_s": 36.34,
                "next_start_s": 54.8,
                "gap_s": 18.46,
                "text": "When you control the breath, you directly activate the part of your nervous system that says calm down."
              },
              {
                "kind": "MULTI",
                "cue_idx": 6,
                "start_s": 54.8,
                "n_sentences": 2,
                "text": "On your screen you're going to see a circle. Follow it."
              },
              {
                "kind": "MULTI",
                "cue_idx": 7,
                "start_s": 71.46,
                "n_sentences": 3,
                "text": "If your mind drifts — bring it back. That is not failure. That is the drill."
              }
            ]
          },
          "ffprobe_duration_s": null,
          "whisper_segments": [
            {
              "start_s": 1.1,
              "end_s": 10.1,
              "text": "Day 5. First physical tool. It's called box breathing. Four sides, four seconds each."
            },
            {
              "start_s": 10.1,
              "end_s": 22.1,
              "text": "Inhale. Hold. Exhale. Hold. Here's what it matters. When you're at a high pressure moment, your body runs hot."
            },
            {
              "start_s": 22.1,
              "end_s": 32.1,
              "text": "Heart rate up. Cortisol up. Your brain shifts into threat mode. And none of that is useful for execution."
            },
            {
              "start_s": 32.1,
              "end_s": 43.1,
              "text": "Box breathing is a reset switch. When you control the breath, you directly activate the part of your nervous system that says, hey calm down."
            },
            {
              "start_s": 43.1,
              "end_s": 54.1,
              "text": "Not eventually within 60 seconds. And once it's trained, you can flip that switch in the middle of competition without anyone knowing you're doing it."
            },
            {
              "start_s": 54.1,
              "end_s": 66.1,
              "text": "On your screen, you're going to see a circle. It expands on the inhale, holds at the top, contracts on the exhale, and holds at the bottom."
            },
            {
              "start_s": 66.1,
              "end_s": 77.1,
              "text": "Each phase is four seconds. Follow it. If your mind drifts, bring it back. That's not failure. That's the drill."
            }
          ],
          "whisper_segment_count": 7
        },
