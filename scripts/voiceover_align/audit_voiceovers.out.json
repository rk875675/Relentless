            },
            {
              "start_s": 44.86,
              "end_s": 49.9,
              "text": "Get into a very comfortable relaxed position and start that breath work with me"
            },
            {
              "start_s": 50.54,
              "end_s": 52.54,
              "text": "Let's focus on the box breath"
            },
            {
              "start_s": 52.54,
              "end_s": 58.7,
